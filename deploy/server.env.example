# Copy to /etc/mcpaste/server.env on the host, set root:root ownership, and chmod 0600.
# Do not commit the populated file or print its values.
MCPASTE_DATABASE_URL=postgres://mcpaste:REPLACE_WITH_RANDOM_PASSWORD@postgres:5432/mcpaste?sslmode=disable
MCPASTE_ACTIVE_KEY_ID=production-key-v1
MCPASTE_ENCRYPTION_KEYS=production-key-v1:REPLACE_WITH_43_CHAR_RAW_URL_BASE64_KEY
MCPASTE_TRUSTED_PROXY_CIDRS=172.16.0.0/12
MCPASTE_CLEANUP_INTERVAL=1m
# Image storage. Leave the S3 block empty to keep images on the mcpaste-data volume.
# Setting it moves image bodies to an S3-compatible bucket; they stay envelope-encrypted,
# so the bucket never holds readable paste content. All five values are required together.
MCPASTE_S3_ENDPOINT=https://REPLACE_WITH_BUCKET.REPLACE_WITH_REGION.digitaloceanspaces.com
MCPASTE_S3_REGION=REPLACE_WITH_REGION
MCPASTE_S3_BUCKET=REPLACE_WITH_BUCKET
MCPASTE_S3_PREFIX=prod
MCPASTE_S3_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
MCPASTE_S3_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY
